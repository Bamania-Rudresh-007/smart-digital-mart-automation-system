PORT=5000
NODE_ENV=development

DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sdmas_db
DB_USER=root
DB_PASSWORD=rootpassword
DB_STORAGE=./sdmas.sqlite

# Set these before running db:seed or db:admin.
SUPERADMIN_EMAIL=rudresh@gmail.com
SUPERADMIN_PASSWORD=

JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_MINUTES=30

CLIENT_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

MATCH_TOLERANCE_PERCENT=2.0
EXPIRY_WARNING_DAYS_1=30
EXPIRY_WARNING_DAYS_2=15
